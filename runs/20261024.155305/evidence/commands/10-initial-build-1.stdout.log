  story=build-entry  "Prove the module builds the ddkstat executable with go build using only the standard library."
  story=log-decode  "Decode the JSON Lines log, one JSON object per non-blank line."
  story=log-required-fields  "Skip records missing a required field, with a line-numbered warning."
  story=log-duplicates  "Skip repeated execution identifiers, keeping the first occurrence."
  story=report-format  "Provide the shared CSV writer and the minutes and cost formatters."
  story=filter-target  "Keep only records whose job.target equals the --target name exactly."
  story=log-numeric  "Treat absent or null token, cost, and duration values as zero."
  story=log-model  "Attribute each record to its executed model, falling back to the requested model."
  story=filter-date  "Keep records whose start date falls within the inclusive --since and --until range."
  story=report-targets  "Produce the per-Target report with a TOTAL row."
  story=report-daily  "Produce the per-date report with a TOTAL row."
  story=report-commands  "Produce the per-command report with a TOTAL row."
  story=report-models  "Produce the per-provider and model report with a TOTAL row."
  story=report-summary  "Produce the one-row summary report."
  story=report-failures  "Produce the failed-record report."
  story=report-empty-match  "Make every report write its header and a zero TOTAL row when no record matches."
  story=cli-parse  "Parse the report name, options, and the single log path, and wire each report."
  story=cli-unreadable-log  "Exit 1 with no stdout when the log cannot be opened or read."
  story=cli-usage-errors  "Map usage errors to exit code 2 with no stdout output."
  story=cli-success-partial  "Exit 0 when lines are skipped or no record matches."
  story=test-runner  "Provide the POSIX bin/test.sh that runs go vet and go test over the whole module."

